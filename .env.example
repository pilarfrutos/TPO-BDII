# Copiar como .env y completar contraseñas locales; nunca subir .env a Git.
MONGODB_URI=mongodb://localhost:27017/?authSource=admin&directConnection=true
MONGODB_DATABASE=farmared_importacion
MONGODB_USER=farmared_admin
MONGODB_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
# Mínimo 8 caracteres; no usar / porque NEO4J_AUTH utiliza ese separador.
NEO4J_PASSWORD=
